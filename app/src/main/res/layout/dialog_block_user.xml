<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/dark_surface">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pilih Durasi Blokir"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <RadioGroup
        android:id="@+id/rgDuration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rb1Day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1 Hari"
            android:textColor="@color/text_secondary"
            android:buttonTint="@color/neon_purple" />

        <RadioButton
            android:id="@+id/rb3Days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3 Hari"
            android:textColor="@color/text_secondary"
            android:buttonTint="@color/neon_purple" />

        <RadioButton
            android:id="@+id/rb7Days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="7 Hari"
            android:textColor="@color/text_secondary"
            android:buttonTint="@color/neon_purple" />

        <RadioButton
            android:id="@+id/rb30Days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="30 Hari"
            android:textColor="@color/text_secondary"
            android:buttonTint="@color/neon_purple" />

        <RadioButton
            android:id="@+id/rbPermanent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Permanen"
            android:textColor="@color/text_secondary"
            android:buttonTint="@color/neon_purple" />

        <RadioButton
            android:id="@+id/rbCustom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Input Manual (Hari)"
            android:textColor="@color/text_secondary"
            android:buttonTint="@color/neon_purple" />
    </RadioGroup>

    <EditText
        android:id="@+id/etCustomDays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Jumlah hari..."
        android:inputType="number"
        android:textColor="@color/white"
        android:textColorHint="@color/text_dim"
        android:visibility="gone"
        android:layout_marginTop="8dp" />

</LinearLayout>
