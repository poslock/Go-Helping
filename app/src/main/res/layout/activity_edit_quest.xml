<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Edit Quest"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="#000000" />
        </LinearLayout>

        <!-- Judul Quest -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Judul Quest"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etQuestTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Masukkan judul quest"
            android:padding="12dp"
            android:background="@drawable/bg_edit_text"
            android:layout_marginBottom="16dp" />

        <!-- Deskripsi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deskripsi"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etQuestDesc"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Deskripsikan quest kamu"
            android:gravity="top"
            android:padding="12dp"
            android:background="@drawable/bg_edit_text"
            android:layout_marginBottom="16dp" />

        <!-- Lokasi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lokasi"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Lokasi quest"
            android:padding="12dp"
            android:background="@drawable/bg_edit_text"
            android:layout_marginBottom="16dp" />

        <!-- Reward -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reward (GD)"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etReward"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Jumlah GD"
            android:inputType="number"
            android:padding="12dp"
            android:background="@drawable/bg_edit_text"
            android:layout_marginBottom="24dp" />

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Tombol Update -->
        <Button
            android:id="@+id/btnUpdateQuest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update Quest"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <!-- Tombol Cancel -->
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Batal"
            android:backgroundTint="#E0E0E0"
            android:textColor="#000000" />
    </LinearLayout>
</ScrollView>