<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_margin="6dp"
    android:background="@drawable/bg_neon_glow"
    android:elevation="4dp">

    <!-- Header: Title + Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvQuestTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Quest Title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Tombol Lapor (hanya untuk helper) -->
        <TextView
            android:id="@+id/btnReportQuest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="16sp"
            android:padding="6dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tvQuestStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open"
            android:textColor="@color/neon_green"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_neon_border"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Creator Name (Clickable) -->
    <LinearLayout
        android:id="@+id/layoutCreatorInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤 "
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvCreatorName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Creator"
            android:textColor="@color/neon_cyan"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Location -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 "
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvQuestLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Location"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Reward -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💰 "
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvQuestReward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100 GD"
            android:textColor="@color/neon_yellow"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btnEditQuest"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="✏️ Edit"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:background="@drawable/bg_button_neon"
        android:layout_marginBottom="6dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnAcceptQuest"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Ambil"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="14sp"
        android:background="@drawable/bg_button_neon" />
</LinearLayout>