<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Tambahkan izin Internet jika menggunakan Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GoHelping"
        tools:targetApi="31">

        <!-- MAIN ACTIVITY (Launcher) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- REGISTER ACTIVITY -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- HOME ACTIVITY -->
        <activity
            android:name=".HomeActivity"
            android:exported="false" />

        <!-- QUEST BOARD ACTIVITY -->
        <activity
            android:name=".QuestBoardActivity"
            android:exported="false" />

        <!-- CHAT ACTIVITY -->
        <activity
            android:name=".ChatActivity"
            android:exported="false" />

        <!-- PROFILE ACTIVITY -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <activity android:name=".MyQuestActivity" />
        <activity android:name=".ChatRoomActivity"/>
        <activity android:name=".EditQuestActivity" />
        <activity android:name=".AdminActivity" />
        <activity android:name=".UserProfileActivity" />


    </application>

</manifest>